<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_before">

    <fragment
        android:id="@+id/navigation_before"
        android:name="com.example.mopa_app.ui.after.AfterFragment"
        android:label="@string/title_before"
        tools:layout="@layout/fragment_after" />

    <fragment
        android:id="@+id/navigation_after"
        android:name="com.example.mopa_app.ui.before.BeforeFragment"
        android:label="@string/title_after"
        tools:layout="@layout/fragment_before" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.example.mopa_app.ui.result.ResultFragment"
        android:label="@string/title_settings"
        tools:layout="@layout/fragment_result" />
    <fragment
        android:id="@+id/navigation_result"
        android:name="com.example.mopa_app.ui.result.ResultFragment"
        android:label="@string/title_result"
        tools:layout="@layout/fragment_result" />
</navigation>